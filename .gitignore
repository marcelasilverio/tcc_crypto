.DS_Store
.spyproject/
.ipynb_checkpoints/
~$*.xlsx
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/

# Research data is reproduced locally and must not be committed.
data/exploration/*
!data/exploration/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/raw/*
!data/raw/.gitkeep

# Generated experiment outputs stay outside version control.
outputs/*
!outputs/.gitkeep
